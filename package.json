{
  "name": "genispace",
  "version": "3.1.0",
  "description": "GeniSpace AI Platform JavaScript SDK - Official client library for GeniSpace platform APIs",
  "main": "./lib/index.cjs",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.cjs",
      "default": "./lib/index.mjs"
    },
    "./streaming": {
      "types": "./lib/streaming/index.d.ts",
      "import": "./lib/streaming/index.mjs",
      "require": "./lib/streaming/index.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genispace/sdk-javascript.git"
  },
  "homepage": "https://genispace.ai",
  "bugs": {
    "url": "https://github.com/genispace/sdk-javascript/issues"
  },
  "keywords": [
    "genispace",
    "ai",
    "platform",
    "sdk",
    "api",
    "client",
    "javascript",
    "typescript",
    "automation",
    "agents",
    "tasks"
  ],
  "author": "GeniSpace.ai Dev Team <dev@genispace.ai>",
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest",
    "test:coverage": "jest --coverage --runInBand",
    "test:watch": "jest --watch",
    "lint": "eslint --ext .ts src",
    "lint:fix": "eslint --ext .ts src --fix",
    "clean": "rm -rf lib",
    "prebuild": "npm run clean",
    "prepublishOnly": "npm run build && npm run lint",
    "publish:beta": "npm publish --tag beta",
    "publish:latest": "npm publish --tag latest"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "esbuild": "^0.27.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "form-data": "^4.0.4"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "lib/**/*",
    "README.md",
    "LICENSE"
  ],
  "jest": {
    "collectCoverageFrom": [
      "lib/streaming/**/*.cjs"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 80
      }
    }
  }
}
